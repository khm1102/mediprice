# Database (DB_URL, DB_USERNAME 그대로 두면 됨)
DB_URL=jdbc:postgresql://db:5774/mediprice?reWriteBatchedInserts=true
DB_USERNAME=mediprice
# 비밀번호는 1Password / 팀 에서 받아 입력
DB_PASSWORD=<your-db-password>
# HikariCP 풀 (Tomcat thread 수와 균형. 기본 30/10 권장)
DB_POOL_SIZE=30
DB_MIN_IDLE=10
DB_MAX_LIFETIME=1800000
# 운영은 30000 (30s) 권장. 0 = 비활성
DB_LEAK_DETECTION=0

# JPA
# 운영 환경에서는 반드시 validate 사용 (update는 데이터 손실 위험)
JPA_DDL_AUTO=update
# 개발 시에만 true 권장 (운영 PII 노출 위험)
JPA_SHOW_SQL=false
JPA_FORMAT_SQL=false

# JWT
# 32바이트(256비트) 이상의 랜덤 문자열 필수 (HMAC-SHA256). 미지정 시 부팅 실패.
# 생성 예: openssl rand -base64 48
JWT_SECRET=<replace-with-random-32-byte-key>
JWT_EXPIRATION=86400000

# Naver Map
NAVER_MAP_KEY=<your-naver-map-key>

# HIRA API
# 단일 키 fallback. 다중 키를 가지면 HIRA_API_KEYS만 채워도 OK.
HIRA_API_KEY=<your-hira-key>
# 콤마 구분 다중 키 (일일 한도 회피용 라운드로빈). 예: key1,key2,key3
HIRA_API_KEYS=

# Cache — 그대로 두면 됨
CACHE_TTL_SECONDS=3600
GUEST_SEARCH_LIMIT=3

# CORS (콤마로 다중 origin 지정 가능)
CORS_ALLOWED_ORIGINS=https://mediprice.khm1102.com
